{
  "name": "setom",
  "version": "1.0.1",
  "packageManager": "npm@11.2.0",
  "description": "S-Expression to Markup",
  "main": "build/main/index.js",
  "typings": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "homepage": "http://github.com/wesleyks/setom",
  "bugs": {
    "url": "http://github.com/wesleyks/setom/issues"
  },
  "author": "Wesley Sun (http://www.wksun.com/)",
  "contributors": [
    {
      "name": "Ben Rothman",
      "url": "http://www.bensrothman.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/wesleyks/setom.git"
  },
  "licenses": [
    {
      "type": "MIT"
    }
  ],
  "keywords": [
    "s-expression",
    "markup"
  ],
  "scripts": {
    "build": "npm run build:main && npm run build:module",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "prepack": "npm run build",
    "test": "npm run test:source && npm run test:package",
    "test:source": "npm run build && npm run typecheck && npm run check && npm run test:unit",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.module.json",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "test:unit": "node --test build/main/lib/setom.spec.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=build/main/lib/setom.spec.js --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=95 build/main/lib/setom.spec.js",
    "watch:build": "tsc -p tsconfig.json -w",
    "watch:test": "node --test --watch build/main/lib/setom.spec.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "build/main",
    "build/module",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ]
}
