{
  "name": "setom",
  "version": "2.0.1",
  "packageManager": "npm@11.2.0",
  "description": "S-Expression to Markup",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "homepage": "https://github.com/wesleyks/setom",
  "bugs": {
    "url": "https://github.com/wesleyks/setom/issues"
  },
  "author": "Wesley Sun (http://www.wksun.com/)",
  "contributors": [
    {
      "name": "Ben Rothman",
      "url": "http://www.bensrothman.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wesleyks/setom.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "s-expression",
    "markup"
  ],
  "scripts": {
    "build": "tsdown --logLevel error",
    "build:test": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run test:source && npm run test:package",
    "test:source": "npm run build:test && npm run typecheck && npm run check && npm run test:unit",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "test:unit": "node --test build/main/lib/setom.spec.js",
    "test:coverage": "npm run build:test && node --test --experimental-test-coverage --test-coverage-exclude=build/main/lib/setom.spec.js --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=95 build/main/lib/setom.spec.js",
    "watch:build": "tsdown --watch",
    "watch:test": "node --test --watch build/main/lib/setom.spec.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ]
}
